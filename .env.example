# === TourAPI (한국관광공사) ===
# 공공데이터포털에서 발급받은 "Decoding" 인증키를 넣으세요 (URL 인코딩된 키 아님)
TOUR_API_SERVICE_KEY=여기에_발급받은_서비스키

# TourAPI 반려동반여행정보 서비스 base URL
# ⚠️ 실제 신청 승인 후 마이페이지 > 활용신청 현황 > 상세보기의 Swagger 문서에서
#    정확한 base URL과 오퍼레이션명(버전 접미사 1/2)을 반드시 재확인할 것
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorPetTourService2

# 앱/웹 식별용 (TourAPI 필수 파라미터)
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=DongbanHagae

# 서버 포트
PORT=4000

# 클라이언트 CORS 허용 origin (로컬 개발용, 배포 시 실제 도메인으로 교체)
CLIENT_ORIGIN=http://localhost:5173
